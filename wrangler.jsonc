{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asteck-bot",
  "compatibility_date": "2026-05-05",
  "pages_build_output_dir": "dashboard/dist",
  "assets": {
    "directory": "dashboard/dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
