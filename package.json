{
  "name": "asteck-traffic",
  "version": "1.0.0",
  "description": "AsTeck Traffic Intelligence — Community-driven traffic safety platform for Cameroon",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build:backend && npm run build:dashboard",
    "build:backend": "tsc",
    "build:dashboard": "cd dashboard && npm install && npm run build",
    "test:atlas-source-understanding": "node --import tsx scripts/verify-atlas-source-understanding.ts",
    "test:atlas-ai-evidence": "node --import tsx scripts/verify-atlas-ai-evidence.ts",
    "test:routing": "node --import tsx scripts/verify-routing-provider.mjs",
    "test:api-contract": "node scripts/verify-api-contract.mjs",
    "test:private-visual-evidence": "node scripts/verify-private-visual-field-review.mjs",
    "test:place-candidate-contract": "node scripts/verify-public-place-candidates.mjs",
    "test:transit-review-authority": "node scripts/verify-transit-review-authority.mjs",
    "test:published-departures": "node --import tsx scripts/verify-published-departures.ts",
    "test:incident-review-operations": "node --import tsx scripts/verify-incident-review-operations.ts",
    "test:map-observation-provenance": "node --import tsx scripts/verify-map-observation-provenance.ts",
    "test:map-signal-fleet": "node --import tsx scripts/verify-map-signal-fleet-authority.ts",
    "test:fleet-position-freshness": "node --import tsx scripts/verify-live-fleet-position-freshness.ts",
    "test:scheduled-departures": "node --import tsx scripts/verify-scheduled-departure-publishing.ts",
    "test:operator-departure-operations": "node --import tsx scripts/verify-operator-departure-operations.ts",
    "test:voice-field-report": "node --import tsx scripts/verify-voice-field-report.ts",
    "test:operator-vehicle-registration": "node --import tsx scripts/verify-operator-vehicle-registration.ts",
    "test:reachability:reviewed-access": "node scripts/verify-reviewed-access-reachability.mjs",
    "test:smoke:production-auth": "node scripts/smoke-production-auth.mjs",
    "start": "node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:routing:smoke": "node routing/cameroon/verify.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^8.0.0",
    "@sentry/profiling-node": "^8.0.0",
    "@supabase/supabase-js": "^2.90.1",
    "@types/node": "^25.0.3",
    "@types/uuid": "^10.0.0",
    "africastalking": "^0.7.9",
    "axios": "^1.13.2",
    "bullmq": "^5.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "groq-sdk": "^0.37.0",
    "ioredis": "^5.0.0",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "qrcode-terminal": "^0.12.0",
    "telegraf": "^4.16.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "whatsapp-web.js": "^1.26.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/multer": "^2.1.0",
    "@types/node-cron": "^3.0.11"
  }
}
