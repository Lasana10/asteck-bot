{
  "name": "dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:pages-env": "node ./scripts/validate-pages-env.cjs",
    "test:env:missing": "node ./scripts/validate-pages-env.cjs --mode=missing",
    "test:env:complete": "node ./scripts/validate-pages-env.cjs --mode=complete",
    "test:env:cf-no-api": "node ./scripts/validate-pages-env.cjs --mode=cf-no-api",
    "build": "npm run validate:pages-env && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/leaflet": "^1.9.21",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "localforage": "^1.10.0",
    "lucide-react": "^0.577.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "framer-motion": "^12.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/leaflet.heat": "^0.2.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0"
  }
}
